rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Online drafts: één document per draft, met de code als naam (bijv. "K7QX").
    match /drafts/{code} {

      // De code moet uit precies 4 tekens bestaan (zoals de app ze maakt).
      function validCode() {
        return code.matches('^[A-HJ-NP-Z2-9]{4}$');
      }

      // Begrenzingen, zodat niemand de database kan volstoppen met enorme documenten.
      function sane(d) {
        return d.seats is list && d.seats.size() >= 2 && d.seats.size() <= 8
            && d.names is list && d.names.size() <= 8
            && d.history is list && d.history.size() <= 100
            && (!('pseq' in d) || (d.pseq is list && d.pseq.size() <= 100))
            && (!('bseq' in d) || (d.bseq is list && d.bseq.size() <= 200));
      }

      // Alleen één draft opvragen met de juiste code; alle drafts opsommen kan niet.
      allow get: if request.auth != null;
      allow list: if false;

      // Aanmaken: alleen ingelogd (anoniem), met geldige code, en jij moet zelf meespelen.
      allow create: if request.auth != null
                    && validCode()
                    && request.auth.uid in request.resource.data.seats
                    && sane(request.resource.data);

      // Aanpassen: alleen als je al meespeelt, of als er nog een plek vrij is (meedoen).
      // Het aantal plekken kan daarbij niet veranderen.
      allow update: if request.auth != null
                    && (request.auth.uid in resource.data.seats || null in resource.data.seats)
                    && sane(request.resource.data)
                    && request.resource.data.seats.size() == resource.data.seats.size();

      // Verwijderen gebeurt automatisch na 30 dagen (TTL op het veld expireAt), niet door spelers.
      allow delete: if false;
    }
  }
}
